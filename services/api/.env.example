# Copy values into .NET User Secrets for local development or inject them as environment variables in hosted environments.
# Do not commit a populated .env file.
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Username=your-email@gmail.com
Email__Smtp__Password=your-gmail-app-password
Email__Smtp__Security=StartTls
Email__Smtp__SenderEmail=your-email@gmail.com
Email__Smtp__SenderDisplayName=Kreyora
Email__Smtp__ApplicationPublicUrl=https://app.example.com
Email__Smtp__PasswordResetTokenLifetimeMinutes=60
