{
  "AllowedHosts": "*",
  "App": {
    "Name": "Kreyora API",
    "Version": "0.1.0"
  },
  "Database": {
    "ConnectionString": ""
  },
  "Storage": {
    "Media": {
      "Provider": "Local",
      "LocalRoot": "AppData/private-media",
      "MaxUploadBytes": 10485760,
      "UploadLifetimeMinutes": 15,
      "ReadLifetimeMinutes": 5,
      "R2": {
        "AccountId": "",
        "BucketName": "",
        "Endpoint": "",
        "AccessKeyId": "",
        "SecretAccessKey": ""
      }
    }
  },
  "Email": {
    "Smtp": {
      "ApplicationName": "Kreyora",
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "Security": "StartTls",
      "SenderEmail": "",
      "SenderDisplayName": "Kreyora",
      "ApplicationPublicUrl": "",
      "PasswordResetTokenLifetimeMinutes": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PublicStorefront": {
    "PlatformBaseDomain": "kreyora.local",
    "EnableDevelopmentSlugRoutes": true,
    "ReadCacheSeconds": 60,
    "WriteBodyLimitBytes": 16384,
    "ReadRequestsPerMinute": 120,
    "QuoteRequestsPerTenMinutes": 20,
    "SessionRequestsPerTenMinutes": 10,
    "OrderRequestsPerHour": 5,
    "TrustedProxyAddresses": []
  },
  "Ai": {
    "Enabled": false,
    "Mode": "Fake",
    "Providers": {
      "GoogleAiStudio": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "NoTraining": false
      }
    },
    "Profiles": {
      "Primary": { "Provider": "GoogleAiStudio", "Model": "gemini-3.5-flash-lite" },
      "Fallback": { "Provider": "GoogleAiStudio", "Model": "gemini-3.5-flash", "ReasoningEffort": "none" }
    },
    "Limits": { "TimeoutSeconds": 30, "MaxOutputTokens": 800 },
    "DataPolicy": { "AllowPersonalData": false }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
