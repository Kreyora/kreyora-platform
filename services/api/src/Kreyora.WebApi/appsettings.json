{
  "AllowedHosts": "*",
  "App": {
    "Name": "Kreyora API",
    "Version": "0.1.0"
  },
  "Database": {
    "ConnectionString": ""
  },
  "Storage": {
    "Media": {
      "Provider": "Local",
      "LocalRoot": "AppData/private-media",
      "MaxUploadBytes": 10485760,
      "UploadLifetimeMinutes": 15,
      "ReadLifetimeMinutes": 5,
      "R2": {
        "AccountId": "",
        "BucketName": "",
        "Endpoint": "",
        "AccessKeyId": "",
        "SecretAccessKey": ""
      }
    }
  },
  "Email": {
    "Smtp": {
      "ApplicationName": "Kreyora",
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "Security": "StartTls",
      "SenderEmail": "",
      "SenderDisplayName": "Kreyora",
      "ApplicationPublicUrl": "",
      "PasswordResetTokenLifetimeMinutes": 60
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PublicStorefront": {
    "PlatformBaseDomain": "kreyora.local",
    "EnableDevelopmentSlugRoutes": true,
    "ReadCacheSeconds": 60,
    "WriteBodyLimitBytes": 16384,
    "ReadRequestsPerMinute": 120,
    "QuoteRequestsPerTenMinutes": 20,
    "SessionRequestsPerTenMinutes": 10,
    "OrderRequestsPerHour": 5,
    "TrustedProxyAddresses": []
  },
  "Ai": {
    "Enabled": false,
    "Mode": "Fake",
    "Providers": {
      "GoogleAiStudio": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "NoTraining": false
      }
    },
    "Profiles": {
      "Primary": { "Provider": "GoogleAiStudio", "Model": "gemini-3.5-flash-lite" },
      "Fallback": { "Provider": "GoogleAiStudio", "Model": "gemini-3.5-flash", "ReasoningEffort": "none" }
    },
    "Limits": { "TimeoutSeconds": 30, "MaxOutputTokens": 800 },
    "DataPolicy": { "AllowPersonalData": false },
    "Embeddings": { "Provider": "GoogleAiStudio", "Model": "gemini-embedding-001", "Dimensions": 768, "BatchSize": 32 },
    "Retrieval": {
      "RelevantThreshold": 0.62,
      "LowConfidenceThreshold": 0.55,
      "LexicalWeight": 0.1,
      "LexicalRelevantThreshold": 0.5,
      "LexicalLowConfidenceThreshold": 0.25,
      "TopK": 4,
      "MaxCharacters": 3000
    },
    "Tools": {
      "TimeoutSeconds": 3,
      "LowStockThreshold": 3,
      "CheckoutLinkHours": 24,
      "MaxLiveLinksPerConversation": 5,
      "MaxHoldsPerConversationPerDay": 10,
      "ConfirmationMinutes": 10
    },
    "Orchestration": {
      "MaxModelCallsPerTurn": 7,
      "MaxToolCallsPerTurn": 8,
      "MaxToolCallsPerResponse": 3,
      "ModelCallTimeoutSeconds": 20,
      "TurnDeadlineSeconds": 45,
      "MaxReplyCharacters": 900,
      "MaxConversationCharacters": 6000,
      "MaxConversationMessages": 20,
      "MaxTokensPerTurn": 20000,
      "MaxTurnsPerTenantPerDay": 150,
      "MaxModelCallsPerDay": 800,
      "MaxConcurrentTurnsPerTenant": 2,
      "MaxCorrectiveRetries": 1,
      "FallbackCooldownHours": 12,
      "CircuitFailureThreshold": 5,
      "CircuitWindowSeconds": 120,
      "CircuitOpenSeconds": 300,
      "TurnLogRetentionDays": 90,
      "DebounceSeconds": 4,
      "NativeReplyCheckSeconds": 30,
      "TriggerSweepMinutes": 30,
      "MaxBusyRetries": 6
    },
    "Entitlements": {
      "Mode": "Allowlist",
      "AllowedTenantIds": []
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
