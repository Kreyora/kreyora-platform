{
  "name": "kreyora",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --filter @kreyora/web dev",
    "build": "pnpm --filter @kreyora/web build",
    "lint": "pnpm --filter @kreyora/web lint",
    "typecheck": "pnpm --filter @kreyora/web typecheck",
    "test": "pnpm --filter @kreyora/web test",
    "test:watch": "pnpm --filter @kreyora/web test:watch",
    "generate:api": "pnpm --filter @kreyora/web generate:api",
    "ci:frontend": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sandbox": "node scripts/sandbox/run.mjs",
    "sandbox:connect": "node scripts/sandbox/instagram-connection.mjs",
    "sandbox:ctl": "node scripts/sandbox/ctl.mjs",
    "sandbox:evidence": "node scripts/sandbox/evidence.mjs",
    "test:sandbox-tools": "node --test \"scripts/sandbox/*.test.mjs\"",
    "ai:probe": "dotnet run --project services/api/tools/Kreyora.AiEvaluation -c Release -- probe",
    "ai:screen": "dotnet run --project services/api/tools/Kreyora.AiEvaluation -c Release -- run --set screening --models \"GoogleAiStudio:gemini-3.5-flash-lite,GoogleAiStudio:gemini-3.5-flash@none\"",
    "ai:report": "dotnet run --project services/api/tools/Kreyora.AiEvaluation -c Release -- report",
    "ai:full": "dotnet run --project services/api/tools/Kreyora.AiEvaluation -c Release -- run --set full --models \"GoogleAiStudio:gemini-3.5-flash-lite,GoogleAiStudio:gemini-3.5-flash@none\"",
    "ai:eval": "node scripts/eval/run-pipeline.mjs",
    "ai:eval:dry": "node scripts/eval/run-pipeline.mjs --fake",
    "ai:eval:report": "dotnet run --project services/api/tools/Kreyora.AiEvaluation -- pipeline-report"
  }
}
